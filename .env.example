# Koli Parts — development template. NEVER commit real production secrets.
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
WEB_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=koliparts
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=koliparts_db
DATABASE_URL=postgresql://koliparts:change_me_local@localhost:5432/koliparts_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Search
SEARCH_PROVIDER=meilisearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=change_me_local_search

# Koli One identity — values must be obtained from the real auth configuration
KOLI_ONE_ORIGIN=https://koli.one
KOLI_ONE_FIREBASE_PROJECT_ID=fire-new-globul
KOLI_ONE_AUTH_ISSUER=https://securetoken.google.com/fire-new-globul
KOLI_ONE_AUTH_AUDIENCE=fire-new-globul
KOLI_ONE_CHECK_REVOKED=true

# eBay
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_REDIRECT_URI=http://localhost:4000/integrations/ebay/oauth/callback
EBAY_MARKETPLACE_ID=EBAY_DE
EBAY_API_BASE_URL=https://api.sandbox.ebay.com
EBAY_OAUTH_BASE_URL=https://api.sandbox.ebay.com/identity/v1/oauth2
EBAY_EPN_CAMPAIGN_ID=
EBAY_AUTOMATED_ORDERING=false
EBAY_APPLICATION_TOKEN_SAFETY_SECONDS=120

# TecDoc / VIN — external contracts required
TECDOC_API_URL=
TECDOC_API_KEY=
VIN_PROVIDER=unconfigured
VIN_PROVIDER_URL=
VIN_PROVIDER_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CAPTURE_MODE=manual

# Optional PayPal (not required for MVP)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional Econt — only enable if selected fulfillment route requires it
ECONT_API_URL=https://demo.econt.com/ee/services
ECONT_USERNAME=
ECONT_PASSWORD=

# App
DEFAULT_LOCALE=bg
SUPPORTED_LOCALES=bg,en
DEFAULT_CURRENCY=EUR
DEFAULT_PROFIT_MARGIN=0.06
QUOTE_TTL_SECONDS=900
PROCUREMENT_LOCK_TTL_SECONDS=1800

# Security
SESSION_SECRET=replace_with_at_least_32_random_bytes
TOKEN_ENCRYPTION_KEY_ID=local-dev-only
ADMIN_MFA_REQUIRED=true
SESSION_COOKIE_NAME=kp_session
SESSION_TTL_SECONDS=604800
CSRF_COOKIE_NAME=kp_csrf

# Feature safety
DISABLE_EBAY_SYNC=false
DISABLE_AUTOMATIC_PROCUREMENT=true
DISABLE_CHECKOUT=false
DISABLE_NEW_ORDERS=false
DISABLE_PAYMENT_CAPTURE=false

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
