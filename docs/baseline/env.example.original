# Koli Parts — Environment Configuration
# All prices and amounts are in EUR (Bulgaria joined Eurozone Jan 1, 2026)

# ── Server ────────────────────────────────
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000

# ── PostgreSQL (Cloud SQL in prod) ────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=koliparts
POSTGRES_PASSWORD=koliparts_dev_pass
POSTGRES_DB=koliparts_db
DATABASE_URL=postgresql://koliparts:koliparts_dev_pass@localhost:5432/koliparts_db

# ── Redis (Memorystore in prod) ───────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── JWT Auth ──────────────────────────────
JWT_SECRET=dev_jwt_secret_change_in_production
JWT_EXPIRATION=7d

# ── Supplier APIs (B2B German Wholesalers) ─
# Add supplier-specific API keys as contracts are signed
# SUPPLIER_1_API_URL=
# SUPPLIER_1_API_KEY=

# ── Econt Express (Bulgarian Courier) ─────
ECONT_API_URL=https://demo.econt.com/ee/services
ECONT_USERNAME=iasp-dev
ECONT_PASSWORD=1Asp-dev

# ── Stripe (EUR payments) ─────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Sentry (Error Tracking) ──────────────
SENTRY_DSN=

# ── App Config ────────────────────────────
DEFAULT_LOCALE=bg
SUPPORTED_LOCALES=bg,en
DEFAULT_PROFIT_MARGIN=0.06
